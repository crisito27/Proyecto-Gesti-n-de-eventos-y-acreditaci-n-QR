# Copia este archivo como .env y ajusta los valores.
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux / macOS:       cp .env.example .env
#
# El archivo .env NO se versiona: está en .gitignore.
# Estos valores son de desarrollo local. En un despliegue real la contraseña
# debe ser generada y no compartirse por el repositorio.

# --- PostgreSQL ---
POSTGRES_USER=acreditaqr
POSTGRES_PASSWORD=acreditaqr_local
POSTGRES_DB=acreditaqr
POSTGRES_PORT_HOST=5432

# --- MongoDB ---
MONGO_DB=acreditaqr_registros
MONGO_PORT_HOST=27017

# --- Backend ---
BACKEND_PORT=8000
DEBUG=false

# --- Frontend ---
FRONTEND_PORT=5173

# Orígenes autorizados para CORS, separados por coma.
CORS_ORIGENES=http://localhost:5173,http://localhost:4173
