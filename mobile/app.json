{
  "expo": {
    "name": "Acredita QR",
    "slug": "acredita-qr-mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Acredita QR necesita acceder a la cámara para escanear entradas."
      }
    },
    "android": {
      "permissions": [
        "CAMERA"
      ],
      "package": "cl.acreditaqr.mobile",
      "versionCode": 2
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Acredita QR necesita acceder a la cámara para escanear entradas."
        }
      ],
      "expo-secure-store",
      "./plugins/withAndroidCleartext"
    ]
  }
}
